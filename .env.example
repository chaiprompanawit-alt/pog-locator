# ── โปรดักชัน (Vercel) ─────────────────────────────────────────────
# ตั้งอย่างใดอย่างหนึ่ง — ได้ค่าจากตอนรัน backfill_index.py (ฝั่ง desktop)
DRIVE_INDEX_FILE_ID=your_drive_file_id_here
# หรือใส่ URL เต็มเองก็ได้ (จะทับ FILE_ID):
# DRIVE_INDEX_URL=https://drive.usercontent.google.com/download?id=xxxx&export=download

# แผนที่ QR (slug → fileId) ของหน้าด่านยืนยันสิทธิ์ /g/<slug>
# ได้ค่าจากตอนรัน export_cards_map.py (ฝั่ง desktop) — ไม่ตั้ง = สแกน QR ไม่ได้
DRIVE_CARDS_FILE_ID=your_drive_file_id_here
# DRIVE_CARDS_URL=https://drive.usercontent.google.com/download?id=xxxx&export=download

# รหัส 4 หลักที่ต้องกรอกก่อนเปิดผัง — **ห้ามใส่ค่าจริงในไฟล์นี้** (repo นี้เป็น public)
# ตั้งค่าจริงบน Vercel เท่านั้น. ไม่ตั้ง = ด่านปิดตาย (หน้าเว็บจะขึ้น error ไม่ปล่อยผ่าน)
# เปลี่ยนค่านี้แล้ว redeploy = คุกกี้ 30 วันของทุกเครื่องหมดอายุทันที ต้องกรอกใหม่หมด
POG_GATE_CODE=your_4_digit_code_here

# ── dev เครื่องตัวเอง (ไม่ต้องต่อ Drive) ───────────────────────────
# ชี้ไปไฟล์ในเครื่อง แล้ว server จะอ่านจากไฟล์นี้แทน Drive
# LOCAL_INDEX_PATH=public/index.json
# LOCAL_CARDS_MAP_PATH=../output/cards_map.json
